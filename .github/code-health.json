{
 "about": "AA-1097 code-health ratchets (.github/scripts/code_health.py). Limits only go down; the baseline .github/code-health-baseline.json only shrinks. Globs: fnmatch, '*' also crosses '/'.",
 "python": {
  "max_complexity": 10,
  "measured": "ruff C901 on 13/11/2026: 10,848 functions, p90=6 p95=9 p97=11 p99=16 max=71; limit 10 (just above p95, the mccabe default)",
  "ruff_version": "0.16.9",
  "target_version": "py312",
  "include": ["*.py"],
  "exclude": [
   {"glob": "tests/*", "reason": "tests: complexity ratchet covers product code; tests still count for file size"},
   {"glob": "*conftest.py", "reason": "pytest fixtures"},
   {"glob": "api/migrations/*", "reason": "migrations are append-only history"}
  ]
 },
 "typescript": {
  "max_complexity": 10,
  "measured": "ESLint complexity (classic) on 13/11/2026: 10,356 functions, p90=4 p95=7 p97=10 p99=19 max=82; limit 10 (p97, same number as Python)",
  "dirs": ["frontend"],
  "include": ["frontend/*.ts", "frontend/*.tsx", "frontend/*.js", "frontend/*.jsx", "frontend/*.mjs", "frontend/*.cjs"],
  "exclude": [
   {"glob": "*.d.ts", "reason": "type declarations, no code"},
   {"glob": "*.generated.ts", "reason": "generated (services/quality/lint.py writes it)"},
   {"glob": "*.generated.*.ts", "reason": "generated (services/quality/lint.py writes it)"},
   {"glob": "*.test.*", "reason": "tests"},
   {"glob": "*.spec.*", "reason": "tests"}
  ]
 },
 "files": {
  "max_lines": 800,
  "include": ["*.py", "*.ts", "*.tsx", "*.js", "*.jsx", "*.mjs", "*.cjs"],
  "exempt": [
   {"glob": "*.generated.ts", "reason": "generated (services/quality/lint.py writes it)"},
   {"glob": "*.generated.*.ts", "reason": "generated (services/quality/lint.py writes it)"},
   {"glob": "*.d.ts", "reason": "type declarations"},
   {"glob": "api/migrations/*", "reason": "migrations are append-only history"},
   {"glob": "*/fixtures/*", "reason": "test fixtures (recorded data)"},
   {"glob": "*/snapshots/*", "reason": "test snapshots (generated)"},
   {"glob": ".agents/*", "reason": "vendored agent skills"},
   {"glob": ".claude/*", "reason": "vendored agent skills and hooks"}
  ]
 }
}
